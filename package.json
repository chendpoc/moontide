{
  "name": "ocula",
  "version": "0.1.0",
  "description": "Ocula — minimal coding agent harness (TypeScript)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && cp -r src/plugins/builtin/code-repl/templates/bodies dist/plugins/builtin/code-repl/templates/",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "ping": "tsx src/llm/healthcheck/ping.ts",
    "test": "vitest run",
    "test:conformance": "vitest run tests/architecture-boundaries.test.ts tests/hook-manifest.test.ts tests/tool-permissions.test.ts tests/agent-runtime.test.ts tests/plugin-manifest.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "dev:ui": "cargo run --manifest-path ui/Cargo.toml -- --workdir ."
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "chalk": "^5.4.1",
    "dotenv": "^16.4.7",
    "glob": "^11.0.1",
    "smol-toml": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.10",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.0.9"
  }
}
