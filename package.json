{
  "name": "moontide-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "MoonTide monorepo workspace",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm build:core && pnpm --filter moontide run build",
    "start": "pnpm --filter moontide run start",
    "dev": "pnpm --filter moontide run dev",
    "ping": "tsx packages/llm/src/healthcheck/ping.ts",
    "test": "vitest run",
    "test:conformance": "vitest run tests/architecture-boundaries.test.ts tests/hook-manifest.test.ts tests/tool-permissions.test.ts tests/trust-policy.test.ts tests/agent-runtime.test.ts tests/plugin-manifest.test.ts",
    "typecheck": "pnpm typecheck:core && pnpm --filter moontide run typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "dev:ui": "cargo run --manifest-path ui/Cargo.toml -- --workdir .",
    "build:core": "pnpm -r --filter '@moontide/*' run build",
    "typecheck:core": "pnpm -r --filter '@moontide/*' run typecheck",
    "test:core": "vitest run packages/agent-core/tests"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.10",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.0.9"
  }
}
