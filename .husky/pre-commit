pnpm exec lint-staged

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$STAGED" ]; then
  doc_only=true
  while IFS= read -r file; do
    [ -z "$file" ] && continue
    case "$file" in
      *.md | *.mdx | docs/*)
        ;;
      *)
        doc_only=false
        break
        ;;
    esac
  done <<EOF
$STAGED
EOF

  if [ "$doc_only" = true ]; then
    echo "pre-commit: docs-only changes, skipping typecheck and test:conformance"
    exit 0
  fi
fi

pnpm run typecheck
pnpm run test:conformance
