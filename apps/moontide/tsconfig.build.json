{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@moontide/shared": ["../../packages/shared/dist/index.d.ts"],
      "@moontide/shared/*": ["../../packages/shared/dist/*"],
      "@moontide/llm": ["../../packages/llm/dist/index.d.ts"],
      "@moontide/llm/protocol": ["../../packages/llm/dist/protocol/index.d.ts"],
      "@moontide/llm/models": ["../../packages/llm/dist/models/index.d.ts"],
      "@moontide/session": ["../../packages/session/dist/index.d.ts"],
      "@moontide/session/stores": ["../../packages/session/dist/stores/index.d.ts"],
      "@moontide/session/block-registry": ["../../packages/session/dist/block-registry.d.ts"],
      "@moontide/context-composer": ["../../packages/context-composer/dist/index.d.ts"],
      "@moontide/context-composer/ports": ["../../packages/context-composer/dist/ports/index.d.ts"],
      "@moontide/context-composer/budget": ["../../packages/context-composer/dist/budget/index.d.ts"],
      "@moontide/context-composer/compaction": ["../../packages/context-composer/dist/compaction/operations.d.ts"],
      "@moontide/log": ["../../packages/log/dist/index.d.ts"],
      "@moontide/tools": ["../../packages/tools/dist/index.d.ts"],
      "@moontide/tools/ports": ["../../packages/tools/dist/ports/index.d.ts"],
      "@moontide/tools/builtins/workspace/fs": ["../../packages/tools/dist/builtins/workspace/fs.d.ts"],
      "@moontide/plugins-sdk": ["../../packages/plugins-sdk/dist/index.d.ts"],
      "@moontide/sidecar-host": ["../../packages/sidecar-host/dist/index.d.ts"],
      "@moontide/sidecar-host/ports": ["../../packages/sidecar-host/dist/ports/index.d.ts"],
      "@moontide/agent-common": ["../../packages/agent-common/dist/index.d.ts"],
      "@moontide/agent-core": ["../../packages/agent-core/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
