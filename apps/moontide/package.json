{
  "name": "moontide",
  "version": "0.1.0",
  "description": "MoonTide CLI harness and product assembly",
  "author": "OceanSpark",
  "type": "module",
  "private": true,
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -r ../../packages/tools/src/extensions/code-repl/templates/bodies dist/plugins/builtin/code-repl/templates/",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "dev": "tsx --tsconfig ../../tsconfig.dev.json src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@moontide/agent-common": "workspace:*",
    "@moontide/agent-core": "workspace:*",
    "@moontide/context-composer": "workspace:*",
    "@moontide/llm": "workspace:*",
    "@moontide/log": "workspace:*",
    "@moontide/plugins-sdk": "workspace:*",
    "@moontide/session": "workspace:*",
    "@moontide/shared": "workspace:*",
    "@moontide/sidecar-host": "workspace:*",
    "@moontide/tools": "workspace:*",
    "chalk": "^5.4.1",
    "dotenv": "^16.4.7",
    "glob": "^11.0.1",
    "smol-toml": "^1.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "license": "MIT"
}
