# DeepSeek（默认）
DEEPSEEK_API_KEY=sk-xxx
MODEL_ID=deepseek-v4-pro
# MODEL_ID=deepseek-v4-flash

# Anthropic 兼容端点（DeepSeek 自动设置，一般不用改）
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 工作区（可选，默认当前目录）
# OCULEAU_WORKDIR=/path/to/project

# --- stderr 显示（默认全部 OFF；JSONL 仍始终写入）---
# OCULEAU_CONTEXT_DISPLAY=1      # stderr context 盒式指标
# OCULEAU_CONTEXT_VERBOSE=1|2    # display ON 时的详略（breakdown 等）
# OCULEAU_CONTEXT_VERBOSE_DETAIL=1
# OCULEAU_TRACE=1                # stderr trace 时间线
# OCULEAU_EVENTS_DISPLAY=1       # stderr EVENT 行（user_prompt / audit）

# --- stdout NDJSON stream（sidecar / desktop）---
# OCULEAU_EVENTS=1
# OCULEAU_EVENTS_LOG=.oculeau/events.jsonl

# Context window 分析（inspect_context / context.jsonl）
# OCULEAU_CONTEXT_LOG=.oculeau/context.jsonl
# OCULEAU_CONTEXT_SNAPSHOT=1
# OCULEAU_CONTEXT_EXACT=0
# OCULEAU_CONTEXT_LIMIT=128000

# --- 其他 Anthropic 兼容提供商 ---
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# MODEL_ID=claude-sonnet-4-6

# OCULUS_* 环境变量仍可读（deprecated），请迁移到 OCULEAU_*
