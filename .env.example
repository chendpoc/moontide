# DeepSeek（默认）
DEEPSEEK_API_KEY=sk-xxx
MODEL_ID=deepseek-v4-pro
# MODEL_ID=deepseek-v4-flash

# Provider preset（目标；实现前可省略，默认 DeepSeek compat）
# MOONTIDE_PROVIDER=deepseek
#   deepseek | kimi | openai | anthropic | gemini | openrouter | custom
# 详见 docs/spec/llm-provider.md（Doc Map：docs/README.md）

# Anthropic 兼容端点（DeepSeek 自动设置，一般不用改）
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# --- 其他官方 preset（按需取消注释）---
# MOONTIDE_PROVIDER=kimi
# MOONSHOT_API_KEY=sk-xxx

# MOONTIDE_PROVIDER=openai
# OPENAI_API_KEY=sk-xxx

# MOONTIDE_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# MOONTIDE_PROVIDER=gemini
# GOOGLE_API_KEY=xxx

# MOONTIDE_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# MODEL_ID=anthropic/claude-sonnet-4

# --- 用户自定义中转（custom preset）---
# MOONTIDE_PROVIDER=custom
# MOONTIDE_CUSTOM_ADAPTER=openai-chat-completions
#   或 anthropic-messages
# MOONTIDE_CUSTOM_BASE_URL=https://relay.example/v1
# CUSTOM_API_KEY=sk-xxx
# MODEL_ID=your-model-id

# 自动 Model Routing（待实现）
# MOONTIDE_MODEL_ROUTING=auto
# MOONTIDE_OPENROUTER_FALLBACK=1

# 工作区（可选，默认当前目录）
# MOONTIDE_WORKDIR=/path/to/project

# Context window 分析（inspect_context；聚合指标写入 run event log）
# MOONTIDE_CONTEXT_EXACT=0
# MOONTIDE_CONTEXT_LIMIT=128000
# MOONTIDE_COMPACT_KEEP_TURNS=3
# MOONTIDE_COMPACT_THRESHOLD=85
# MOONTIDE_COMPACT_AUTO=1

# Tool output projection（Rust R1）
# MOONTIDE_TOOL_INLINE_MAX=8192
# MOONTIDE_TOOL_ARTIFACT_MIN=8192
# MOONTIDE_TOOL_PREVIEW_CHARS=500
# MOONTIDE_TOOL_INLINE_FLOOR=500

# Dev：模型主动记录 tool 用法改进建议
# MOONTIDE_DEV_TOOL_LEARNING=1

# code_repl（多 runtime 代码执行）
# MOONTIDE_CODE_REPL_DEFAULT_RUNTIME=tsx
# MOONTIDE_CODE_REPL_TIMEOUT_MS=120000
# MOONTIDE_PYTHON=/usr/bin/python3
# MOONTIDE_VENV=/path/to/venv
# MOONTIDE_CODE_REPL_DISABLED=1

# deep_research（实验性网络调研 tool，默认不注册）
# MOONTIDE_DEEP_RESEARCH=1
# MOONTIDE_TAVILY_API_KEY=tvly-xxx   # 可选；不设则 Tavily keyless 模式

# http_fetch（HTTP 请求 tool，默认注册；需用户批准）
# MOONTIDE_HTTP=0   # 设为 0 则完全禁用 http_fetch

# 终端 observability（stderr chalk 渲染；run event log 始终写入，**默认关闭**）
# MOONTIDE_THINKING=1    # 调用链：thinking · tool · result
# MOONTIDE_VERBOSE=1     # 含 context 盒、audit、conversation
# MOONTIDE_TRACE_PREVIEW_CHARS=80   # thinking trace 单行 preview 长度（默认 80）
# MOONTIDE_DEBUG=1       # 或 terminal | file — 无截断全量 compose/llm/tool（file 额外落盘 .moontide/debug/）

# Rust CLI：ask 类 tool 自动批准（默认 off，仍受 Deny 规则约束）
# MOONTIDE_ALWAYS_ALLOW=1
