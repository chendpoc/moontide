# DeepSeek（默认）
DEEPSEEK_API_KEY=sk-xxx
MODEL_ID=deepseek-v4-pro
# MODEL_ID=deepseek-v4-flash

# Provider preset（目标；实现前可省略，默认 DeepSeek compat）
# OCULEAU_PROVIDER=deepseek
#   deepseek | kimi | openai | anthropic | gemini | openrouter | custom
# 详见 docs/spec/llm-provider.md（Doc Map：docs/README.md）

# Anthropic 兼容端点（DeepSeek 自动设置，一般不用改）
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# --- 其他官方 preset（按需取消注释）---
# OCULEAU_PROVIDER=kimi
# MOONSHOT_API_KEY=sk-xxx

# OCULEAU_PROVIDER=openai
# OPENAI_API_KEY=sk-xxx

# OCULEAU_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OCULEAU_PROVIDER=gemini
# GOOGLE_API_KEY=xxx

# OCULEAU_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# MODEL_ID=anthropic/claude-sonnet-4

# --- 用户自定义中转（custom preset）---
# OCULEAU_PROVIDER=custom
# OCULEAU_CUSTOM_ADAPTER=openai-chat-completions
#   或 anthropic-messages
# OCULEAU_CUSTOM_BASE_URL=https://relay.example/v1
# CUSTOM_API_KEY=sk-xxx
# MODEL_ID=your-model-id

# 自动 Model Routing（待实现）
# OCULEAU_MODEL_ROUTING=auto
# OCULEAU_OPENROUTER_FALLBACK=1

# 工作区（可选，默认当前目录）
# OCULEAU_WORKDIR=/path/to/project

# Context window 分析（inspect_context；聚合指标写入 run event log）
# OCULEAU_CONTEXT_EXACT=0
# OCULEAU_COMPACT_KEEP_TURNS=3
# OCULEAU_COMPACT_THRESHOLD=85
# OCULEAU_COMPACT_AUTO=1

# code_repl（多 runtime 代码执行）
# OCULEAU_CODE_REPL_DEFAULT_RUNTIME=tsx
# OCULEAU_CODE_REPL_TIMEOUT_MS=120000
# OCULEAU_PYTHON=/usr/bin/python3
# OCULEAU_VENV=/path/to/venv
# OCULEAU_CODE_REPL_DISABLED=1

# deep_research（实验性网络调研 tool，默认不注册）
# OCULEAU_DEEP_RESEARCH=1
# OCULEAU_TAVILY_API_KEY=tvly-xxx   # 可选；不设则 Tavily keyless 模式

# http_fetch（HTTP 请求 tool，默认注册；需用户批准）
# OCULEAU_HTTP=0   # 设为 0 则完全禁用 http_fetch

# 终端 observability（stderr chalk 渲染；run event log 始终写入，**默认关闭**）
# OCULEAU_THINKING=1    # 调用链：thinking · tool · result
# OCULEAU_VERBOSE=1     # 含 context 盒、audit、conversation
