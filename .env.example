# DeepSeek（默认 preset）
DEEPSEEK_API_KEY=sk-xxx

# Agnes AI（Agent 文本模型 preset）
# AGNES_API_KEY=sk-xxx
# MOONTIDE_PROVIDER=agnes

# Provider preset（默认 deepseek）
# MOONTIDE_PROVIDER=deepseek

# 对最终 provider 生效的显式 model / endpoint override（可选）
# MOONTIDE_MODEL=deepseek-chat
# MOONTIDE_BASE_URL=https://api.deepseek.com
# 空白值为配置错误；Adapter family 与 thinking extension 由 catalog 解析，不能由环境变量覆盖

# Live LLM contract tests (optional; requires DEEPSEEK_API_KEY)
# MOONTIDE_LIVE_LLM=1

# 工作区（可选，默认当前目录）
# MOONTIDE_WORKDIR=/path/to/project

# 运行环境：dev 本地开发（默认 auto-approve ask 类工具）；production 或未设（默认需确认）
# MOONTIDE_ENV=dev
# MOONTIDE_ALWAYS_ALLOW=1   # 显式覆盖 dev/production 预设：1/on 开 · 0/off 关

# Context window 分析（inspect_context；聚合指标写入 run event log）
# MOONTIDE_CONTEXT_EXACT=0
# MOONTIDE_CONTEXT_LIMIT=128000
# MOONTIDE_COMPACT_KEEP_TURNS=3
# MOONTIDE_COMPACT_THRESHOLD=85
# MOONTIDE_COMPACT_AUTO=1
# Context Budget Tiers（L1–L4 分账 cap，见 docs/notes/context-backlog.md §3）
# MOONTIDE_CONTEXT_BUDGET_FLEX=0
# MOONTIDE_CONTEXT_BUDGET_L1=32000
# MOONTIDE_CONTEXT_BUDGET_L3=10000
# MOONTIDE_CONTEXT_BUDGET_L4=12000
# MOONTIDE_CONTEXT_BUDGET_L5=6400
# MOONTIDE_CONTEXT_BUDGET_FLEX_PCT=5

# Tool output projection（Rust R1）
# MOONTIDE_ARTIFACT_SPILL_THRESHOLD_BYTES=8192
# MOONTIDE_TOOL_PREVIEW_CHARS=1638   # 默认 = spill 阈值 × 20%；可单独覆盖
# MOONTIDE_TOOL_ARTIFACT_MIN=8192    # Rust compose spill 阈值
# MOONTIDE_TOOL_INLINE_MAX=8192
# MOONTIDE_TOOL_INLINE_FLOOR=500

# Dev：模型主动记录 tool 用法改进建议
# MOONTIDE_DEV_TOOL_LEARNING=1

# code_repl（多 runtime 代码执行）
# MOONTIDE_CODE_REPL_DEFAULT_RUNTIME=tsx
# MOONTIDE_CODE_REPL_TIMEOUT_MS=120000
# MOONTIDE_PYTHON=/usr/bin/python3
# MOONTIDE_VENV=/path/to/venv
# MOONTIDE_CODE_REPL_DISABLED=1

# deep_research（实验性网络调研 tool，默认不注册）
# MOONTIDE_DEEP_RESEARCH=1
# MOONTIDE_TAVILY_API_KEY=tvly-xxx   # 可选；不设则 Tavily keyless 模式

# http_fetch（HTTP 请求 tool，默认注册；需用户批准）
# MOONTIDE_HTTP=0   # 设为 0 则完全禁用 http_fetch

# 终端 observability（stderr chalk 渲染；run event log 始终写入，**默认关闭**）
# MOONTIDE_THINKING=1    # 调用链：thinking · tool · result
# MOONTIDE_VERBOSE=1     # 含 context 盒、audit、conversation
# MOONTIDE_TRACE_PREVIEW_CHARS=80   # thinking trace 单行 preview 长度（默认 80）
# MOONTIDE_DEBUG=1       # 或 terminal | file — 无截断全量 compose/llm/tool（stderr + .moontide/debug/）

# Rust CLI：ask 类 tool 自动批准（默认 off，仍受 Deny 规则约束）
# MOONTIDE_ENV=dev          # dev 预设默认开启 always-allow
# MOONTIDE_ALWAYS_ALLOW=1   # 显式覆盖预设
