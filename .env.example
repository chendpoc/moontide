# DeepSeek（默认）
DEEPSEEK_API_KEY=sk-xxx
MODEL_ID=deepseek-v4-pro
# MODEL_ID=deepseek-v4-flash

# Anthropic 兼容端点（DeepSeek 自动设置，一般不用改）
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 工作区（可选，默认当前目录）
# OCULUS_WORKDIR=/path/to/project

# Context window 观测（可选）
# OCULUS_CONTEXT_VERBOSE=0   # 0=关 1=summary 2=struct tree
# OCULUS_CONTEXT_LOG=.oculus/context.jsonl
# OCULUS_CONTEXT_SNAPSHOT=1  # 另存每 turn 完整 messages 快照
# OCULUS_CONTEXT_EXACT=0     # inspect_context 默认是否走 countTokens API
# OCULUS_CONTEXT_LIMIT=128000

# --- 其他 Anthropic 兼容提供商 ---
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# MODEL_ID=claude-sonnet-4-6
