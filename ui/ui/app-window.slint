import { TabWidget, Button, ScrollView } from "std-widgets.slint";
import { TraceRow } from "components/trace-row.slint";
import { ChatRow } from "components/chat-row.slint";
import { ContextCard } from "components/context-card.slint";

export struct TraceRowData {
    turn: int,
    icon: string,
    label: string,
    extra: string,
    body: string,
}

export struct ChatRowData {
    kind: string,
    turn: int,
    text: string,
}

export struct ContextCardData {
    title: string,
    line1: string,
    line2: string,
    line3: string,
    line4: string,
    alert: string,
}

export component AppWindow inherits Window {
    preferred-width: 960px;
    preferred-height: 720px;
    title: "Oculeau UI";
    background: #11111b;

    callback pick-workdir();

    in-out property <string> workdir-path: "";
    in-out property <string> status-phase: "—";
    in-out property <string> status-model: "—";
    in-out property <string> status-turn: "—";
    in-out property <string> status-context: "—";

    in-out property <[TraceRowData]> trace-rows: [];
    in-out property <[ChatRowData]> chat-rows: [];
    in-out property <[ContextCardData]> context-cards: [];

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        Rectangle {
            background: #181825;
            border-radius: 8px;
            height: 48px;

            HorizontalLayout {
                padding: 10px;
                spacing: 12px;

                Button {
                    text: "Pick…";
                    clicked => { root.pick-workdir(); }
                }

                Text {
                    text: status-phase == "running" ? "● running" : "○ idle";
                    color: status-phase == "running" ? #a6e3a1 : #a6adc8;
                    font-size: 12px;
                }

                Text { text: status-model; color: #cdd6f4; font-size: 12px; }
                Text { text: "turn " + status-turn; color: #f9e2af; font-size: 12px; }
                Text { text: "ctx " + status-context; color: #89b4fa; font-size: 12px; }

                Text {
                    text: workdir-path;
                    color: #6c7086;
                    font-size: 11px;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }

        TabWidget {
            vertical-stretch: 1;

            Tab {
                title: "Trace";
                ScrollView {
                    VerticalLayout {
                        padding: 4px;
                        spacing: 4px;
                        for row[index] in trace-rows: TraceRow {
                            turn: row.turn;
                            icon: row.icon;
                            label: row.label;
                            extra: row.extra;
                            body: row.body;
                        }
                    }
                }
            }

            Tab {
                title: "Context";
                ScrollView {
                    VerticalLayout {
                        padding: 4px;
                        spacing: 8px;
                        for card[index] in context-cards: ContextCard {
                            title: card.title;
                            line1: card.line1;
                            line2: card.line2;
                            line3: card.line3;
                            line4: card.line4;
                            alert: card.alert;
                        }
                    }
                }
            }

            Tab {
                title: "Chat";
                ScrollView {
                    VerticalLayout {
                        padding: 4px;
                        spacing: 6px;
                        for row[index] in chat-rows: ChatRow {
                            kind: row.kind;
                            turn: row.turn;
                            text: row.text;
                        }
                    }
                }
            }
        }
    }
}
