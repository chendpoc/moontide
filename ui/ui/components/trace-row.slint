export component TraceRow inherits Rectangle {
    in property <int> turn;
    in property <string> icon;
    in property <string> label;
    in property <string> extra;
    in property <string> body;

    background: #1e1e2e;
    border-radius: 6px;

    VerticalLayout {
        padding: 8px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "turn " + turn;
                color: #f9e2af;
                font-size: 11px;
            }
            Text {
                text: icon + " " + label;
                color: #89b4fa;
                font-size: 11px;
                font-weight: 600;
            }
            Text {
                text: extra;
                color: #fab387;
                font-size: 11px;
            }
        }

        Text {
            text: body;
            color: #cdd6f4;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}
