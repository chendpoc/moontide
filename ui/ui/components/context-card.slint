export component ContextCard inherits Rectangle {
    in property <string> title;
    in property <string> line1;
    in property <string> line2;
    in property <string> line3;
    in property <string> line4;
    in property <string> alert;

    background: #1e1e2e;
    border-radius: 6px;

    VerticalLayout {
        padding: 10px;
        spacing: 4px;

        Text {
            text: title;
            color: #89b4fa;
            font-size: 12px;
            font-weight: 600;
        }

        Text { text: line1; color: #cdd6f4; font-size: 12px; wrap: word-wrap; }
        Text { text: line2; color: #cdd6f4; font-size: 12px; wrap: word-wrap; }
        Text { text: line3; color: #cdd6f4; font-size: 12px; wrap: word-wrap; }
        Text { text: line4; color: #cdd6f4; font-size: 12px; wrap: word-wrap; }

        Text {
            text: alert;
            color: #f38ba8;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}
