export component ChatRow inherits Rectangle {
    in property <string> kind;
    in property <int> turn;
    in property <string> text;

    horizontal-stretch: 1;
    background: kind == "user_prompt" ? #313244 : #45475a;
    border-radius: 8px;

    VerticalLayout {
        padding: 10px;
        spacing: 4px;

        Text {
            text: kind == "user_prompt" ? "You · turn " + turn : "Oculeau · turn " + turn;
            color: kind == "user_prompt" ? #89dceb : #a6e3a1;
            font-size: 11px;
            font-weight: 600;
        }

        Text {
            text: root.text;
            color: #cdd6f4;
            font-size: 13px;
            wrap: word-wrap;
        }
    }
}
