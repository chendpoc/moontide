{
  "version": "2",
  "bucket": "E",
  "cases": [
    {
      "id": "regression-hello-word",
      "category": "regression",
      "gradingMode": "objective",
      "steps": [{ "type": "prompt", "content": "Say hello in one word." }],
      "expectedChecks": [{ "kind": "reply_matches", "pattern": "(?i)\\b(hi|hello|hey)\\b" }]
    },
    {
      "id": "regression-read-file-exact",
      "category": "regression",
      "gradingMode": "objective",
      "steps": [{ "type": "prompt", "content": "Read demo.txt and reply with its exact content only." }],
      "setup": { "files": { "demo.txt": "hello" } },
      "expectedChecks": [{ "kind": "reply_contains", "value": "hello" }]
    },
    {
      "id": "regression-simple-arithmetic",
      "category": "regression",
      "gradingMode": "objective",
      "steps": [{ "type": "prompt", "content": "What is 17 + 25? Number only." }],
      "expectedChecks": [{ "kind": "reply_matches", "pattern": "\\b42\\b" }]
    },
    {
      "id": "regression-yes-no-typescript",
      "category": "regression",
      "gradingMode": "objective",
      "steps": [{ "type": "prompt", "content": "Is TypeScript a superset of JavaScript? yes or no only." }],
      "expectedChecks": [{ "kind": "reply_matches", "pattern": "(?i)\\byes\\b" }]
    },
    {
      "id": "regression-single-color",
      "category": "regression",
      "gradingMode": "objective",
      "steps": [{ "type": "prompt", "content": "What color do you get mixing red and blue? One word." }],
      "expectedChecks": [{ "kind": "reply_matches", "pattern": "(?i)purple|violet" }]
    },
    {
      "id": "regression-no-tool-capital-italy",
      "category": "regression",
      "gradingMode": "objective",
      "steps": [{ "type": "prompt", "content": "Capital of Italy? One word. Do not use any tools." }],
      "expectedChecks": [{ "kind": "reply_matches", "pattern": "(?i)Rome|Roma" }]
    },
    {
      "id": "regression-json-one-sentence",
      "category": "regression",
      "gradingMode": "subjective",
      "steps": [{ "type": "prompt", "content": "Explain JSON in one sentence for a junior developer." }]
    },
    {
      "id": "regression-list-three-continents",
      "category": "regression",
      "gradingMode": "objective",
      "steps": [{ "type": "prompt", "content": "Name any three continents. Comma-separated, three names only." }],
      "expectedChecks": [
        { "kind": "reply_matches", "pattern": "(?i)(Africa|Antarctica|Asia|Europe|North America|South America|Oceania|Australia)" }
      ]
    },
    {
      "id": "regression-reverse-string",
      "category": "regression",
      "gradingMode": "objective",
      "steps": [{ "type": "prompt", "content": "Reverse the string moon. Reply with result only." }],
      "expectedChecks": [{ "kind": "reply_contains", "value": "noom" }]
    },
    {
      "id": "regression-ack-short",
      "category": "regression",
      "gradingMode": "objective",
      "steps": [{ "type": "prompt", "content": "Reply with exactly: OK" }],
      "expectedChecks": [{ "kind": "reply_matches", "pattern": "^\\s*OK\\s*\\.?$" }]
    }
  ]
}
