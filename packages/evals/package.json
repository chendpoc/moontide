{
  "name": "@moontide/evals",
  "version": "0.1.0",
  "description": "MoonTide harness feature A/B evaluation (dev-tool package)",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts tests",
    "test:integration": "vitest run --config vitest.config.ts examples",
    "eval:pr": "pnpm run test"
  },
  "dependencies": {
    "@moontide/agent": "workspace:*",
    "@moontide/llm": "workspace:*",
    "@moontide/log": "workspace:*",
    "@moontide/session": "workspace:*",
    "@moontide/shared": "workspace:*",
    "@moontide/tools": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "license": "MIT"
}
