{
  "name": "@moontide/context-composer",
  "version": "0.0.1",
  "description": "MoonTide context composer — compile SessionContext into LLMRequest + manifest",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./budget": {
      "types": "./dist/budget/index.d.ts",
      "import": "./dist/budget/index.js"
    },
    "./compaction": {
      "types": "./dist/compaction/operations.d.ts",
      "import": "./dist/compaction/operations.js"
    },
    "./ports": {
      "types": "./dist/ports/index.d.ts",
      "import": "./dist/ports/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@moontide/llm": "workspace:*",
    "@moontide/session": "workspace:*",
    "@moontide/shared": "workspace:*"
  },
  "license": "MIT"
}
