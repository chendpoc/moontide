{
  "name": "@moontide/agent-cli",
  "version": "0.1.0",
  "description": "MoonTide agent CLI (REPL, terminal I/O, observability wiring)",
  "author": "OceanSpark",
  "type": "module",
  "private": true,
  "exports": {
    "./bootstrap": {
      "types": "./dist/bootstrap.d.ts",
      "import": "./dist/bootstrap.js"
    },
    "./bootstrap-env": {
      "types": "./dist/bootstrap-env.d.ts",
      "import": "./dist/bootstrap-env.js"
    },
    "./cli-event-outputs": {
      "types": "./dist/log/cli-event-outputs.d.ts",
      "import": "./dist/log/cli-event-outputs.js"
    },
    "./log/setup": {
      "types": "./dist/log/setup.d.ts",
      "import": "./dist/log/setup.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "dev": "tsx --tsconfig ../../tsconfig.dev.json src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@moontide/agent": "workspace:*",
    "@moontide/context-composer": "workspace:*",
    "@moontide/llm": "workspace:*",
    "@moontide/log": "workspace:*",
    "@moontide/run-protocol": "workspace:*",
    "@moontide/session": "workspace:*",
    "@moontide/shared": "workspace:*",
    "@moontide/tools": "workspace:*",
    "chalk": "^5.4.1",
    "dotenv": "^16.4.7",
    "glob": "^11.0.1",
    "smol-toml": "^1.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "license": "MIT"
}
