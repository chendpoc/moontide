{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@moontide/shared": ["../shared/dist/index.d.ts"],
      "@moontide/shared/*": ["../shared/dist/*"],
      "@moontide/llm": ["../llm/dist/index.d.ts"],
      "@moontide/llm/protocol": ["../llm/dist/protocol/index.d.ts"],
      "@moontide/llm/models": ["../llm/dist/models/index.d.ts"],
      "@moontide/session": ["../session/dist/index.d.ts"],
      "@moontide/session/stores": ["../session/dist/stores/index.d.ts"],
      "@moontide/session/block-registry": ["../session/dist/block-registry.d.ts"],
      "@moontide/context-composer": ["../context-composer/dist/index.d.ts"],
      "@moontide/context-composer/ports": ["../context-composer/dist/ports/index.d.ts"],
      "@moontide/context-composer/budget": ["../context-composer/dist/budget/index.d.ts"],
      "@moontide/context-composer/compaction": ["../context-composer/dist/compaction/operations.d.ts"],
      "@moontide/tools": ["../tools/dist/index.d.ts"],
      "@moontide/tools/ports": ["../tools/dist/ports/index.d.ts"],
      "@moontide/tools/builtins/workspace/fs": ["../tools/dist/builtins/workspace/fs.d.ts"],
      "@moontide/run-protocol": ["../run-protocol/dist/index.d.ts"],
      "@moontide/agent": ["../agent/dist/index.d.ts"],
      "@moontide/agent/testing": ["../agent/dist/testing/index.d.ts"],
      "@moontide/agent/observability": ["../agent/dist/observability.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
