{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@moontide/llm": ["../llm/dist/index.d.ts"],
      "@moontide/llm/protocol": ["../llm/dist/protocol/index.d.ts"],
      "@moontide/plugins-sdk": ["../plugins-sdk/dist/index.d.ts"],
      "@moontide/shared": ["../shared/dist/index.d.ts"],
      "@moontide/shared/*": ["../shared/dist/*"],
      "@moontide/tools": ["../tools/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
