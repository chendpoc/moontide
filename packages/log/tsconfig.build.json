{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@moontide/agent-common": ["../agent-common/dist/index.d.ts"],
      "@moontide/shared": ["../shared/dist/index.d.ts"],
      "@moontide/shared/*": ["../shared/dist/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
