{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "MoonTide Desktop integrated runtime capabilities",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-list-sessions",
    "allow-new-chat",
    "allow-create-session",
    "allow-start-session",
    "allow-load-session-history",
    "allow-submit-turn",
    "allow-cancel-turn",
    "allow-approve",
    "allow-deny",
    "allow-snapshot",
    "allow-shutdown"
  ]
}
