{
  "extends": "./packages/agent-cli/tsconfig.build.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true
  },
  "include": [
    "packages/**/*.ts",
    "apps/**/*.ts",
    "tests/**/*.ts",
    "packages/evals/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "packages/agent-cli/dist",
    "packages/tools/src/extensions/code-repl/templates/bodies"
  ]
}
